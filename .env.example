# From https://developers.kite.trade/ — create an app and set redirect URL to:
#   ${APP_URL}/api/auth/callback
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Random string, at least 32 characters (used to encrypt session cookie)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Public URL where this app runs (no trailing slash). Required locally; optional on Vercel.
APP_URL=http://localhost:4321
